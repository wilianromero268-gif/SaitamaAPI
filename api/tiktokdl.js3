const { execFile } = require('child_process')
const { promisify } = require('util')
const https = require('https')
const http = require('http')

const execFileAsync = promisify(execFile)

const YTDLP = 'yt-dlp'


// ========================================
// HTTP REDIRECT
// Resuelve vt.tiktok.com / vm.tiktok.com
// ========================================

function resolveRedirect(url) {

    return new Promise((resolve, reject) => {

        const client = url.startsWith('https://')
            ? https
            : http

        const request = client.get(
            url,
            {
                headers: {
                    'User-Agent':
                        'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/144 Safari/537.36',
                    'Accept':
                        'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
                }
            },
            response => {

                // Redirecciones
                if (
                    response.statusCode >= 300 &&
                    response.statusCode < 400 &&
                    response.headers.location
                ) {

                    const location =
                        new URL(
                            response.headers.location,
                            url
                        ).href

                    response.resume()

                    return resolveRedirect(location)
                        .then(resolve)
                        .catch(reject)
                }


                // Ya tenemos la URL final
                if (response.statusCode >= 200 &&
                    response.statusCode < 300) {

                    resolve(url)

                } else {

                    reject(
                        new Error(
                            `HTTP ${response.statusCode}`
                        )
                    )
                }

            }
        )

        request.setTimeout(15000, () => {

            request.destroy(
                new Error('Request timeout')
            )

        })

        request.on('error', reject)

    })

}


// ========================================
// RESOLVER TIKTOK
// ========================================

async function resolveTikTokUrl(url) {

    // URL larga
    if (
        url.includes('tiktok.com/@') &&
        url.includes('/video/')
    ) {
        return url
    }


    // URL corta
    if (
        url.includes('vt.tiktok.com') ||
        url.includes('vm.tiktok.com')
    ) {

        try {

            const redirected =
                await resolveRedirect(url)

            if (
                redirected.includes(
                    'tiktok.com/@'
                ) &&
                redirected.includes('/video/')
            ) {

                return redirected
            }

        } catch {
            // Intentamos con yt-dlp abajo
        }
    }


    // Último intento con yt-dlp
    try {

        const { stdout } =
            await execFileAsync(
                YTDLP,
                [
                    '--print',
                    'webpage_url',
                    '--skip-download',
                    '--no-warnings',
                    '--no-playlist',
                    url
                ],
                {
                    maxBuffer:
                        10 * 1024 * 1024,

                    timeout:
                        60000
                }
            )

        const resolved =
            stdout
                .trim()
                .split('\n')
                .map(x => x.trim())
                .find(x =>
                    x.startsWith(
                        'https://www.tiktok.com/@'
                    ) &&
                    x.includes('/video/')
                )

        if (resolved) {
            return resolved
        }

    } catch {
        // Se utiliza la URL original
    }


    return url
}


// ========================================
// EXTRAER TIKTOK
// ========================================

async function getTikTok(url) {

    const { stdout } =
        await execFileAsync(
            YTDLP,
            [
                '--dump-single-json',
                '--skip-download',
                '--no-warnings',
                '--no-playlist',
                url
            ],
            {
                maxBuffer:
                    50 * 1024 * 1024,

                timeout:
                    120000
            }
        )

    return JSON.parse(stdout)
}


// ========================================
// MEJOR VIDEO
// ========================================

function getBestVideo(info) {

    const formats =
        (info.formats || [])
            .filter(format =>
                format.ext === 'mp4' &&
                format.vcodec !== 'none' &&
                format.acodec !== 'none' &&
                format.url
            )
            .sort((a, b) =>
                (b.height || 0) -
                (a.height || 0)
            )


    return formats[0]?.url || null
}


// ========================================
// IMÁGENES
// ========================================

function getImages(info) {

    const images = []


    // thumbnails
    if (Array.isArray(info.thumbnails)) {

        for (const item of info.thumbnails) {

            if (item?.url) {
                images.push(item.url)
            }

        }

    }


    // images
    if (Array.isArray(info.images)) {

        for (const item of info.images) {

            if (typeof item === 'string') {

                images.push(item)

            } else if (item?.url) {

                images.push(item.url)

            }

        }

    }


    // eliminar duplicados
    return [
        ...new Set(images)
    ]
}


// ========================================
// ENDPOINT
// ========================================

async function tiktokdl(req, res) {

    const url = req.query.url


    // ====================================
    // VALIDAR URL
    // ====================================

    if (!url) {

        return res.status(400).json({

            status: false,

            code: 400,

            error: 'Bad Request',

            message:
                'El parámetro url es obligatorio'

        })

    }


    // ====================================
    // VALIDAR TIKTOK
    // ====================================

    if (
        !url.includes('tiktok.com')
    ) {

        return res.status(400).json({

            status: false,

            code: 400,

            error: 'Invalid URL',

            message:
                'La URL no pertenece a TikTok'

        })

    }


    try {

        // ==================================
        // RESOLVER URL
        // ==================================

        const resolvedUrl =
            await resolveTikTokUrl(url)


        // ==================================
        // EXTRAER INFORMACIÓN
        // ==================================

        const info =
            await getTikTok(resolvedUrl)


        // ==================================
        // VIDEO
        // ==================================

        const video =
            getBestVideo(info)


        // ==================================
        // IMÁGENES
        // ==================================

        const images =
            getImages(info)


        // ==================================
        // TIPO
        // ==================================

        let type = 'unknown'

        if (video) {

            type = 'video'

        } else if (images.length) {

            type = 'image'

        }


        // ==================================
        // RESPUESTA
        // ==================================

        return res.json({

            status: true,

            code: 200,

            creator: 'SaiDev145',

            type,


            // ==============================
            // CONTENIDO
            // ==============================

            video:
                video || null,

            images,

            thumbnail:
                info.thumbnail ||
                images[0] ||
                null,


            // ==============================
            // INFORMACIÓN
            // ==============================

            id:
                info.id ||
                null,

            title:
                info.title ||
                info.description ||
                null,

            description:
                info.description ||
                null,


            // ==============================
            // AUTOR
            // ==============================

            username:
                info.uploader ||
                null,

            author: {

                username:
                    info.uploader ||
                    null,

                name:
                    info.channel ||
                    null,

                id:
                    info.uploader_id ||
                    null

            },


            // ==============================
            // ESTADÍSTICAS
            // ==============================

            duration:
                info.duration ||
                0,

            views:
                info.view_count ||
                0,

            likes:
                info.like_count ||
                0,

            comments:
                info.comment_count ||
                0,

            reposts:
                info.repost_count ||
                0,

            saves:
                info.save_count ||
                0,


            // ==============================
            // URLS
            // ==============================

            url,

            resolved_url:
                resolvedUrl,

            source:
                info.webpage_url ||
                resolvedUrl ||
                url

        })


    } catch (error) {

        return res.status(500).json({

            status: false,

            code: 500,

            error:
                'TikTok Extraction Error',

            message:
                'No se pudo obtener el contenido de TikTok',

            detail:
                error?.stderr?.trim() ||
                error?.message ||
                'Error desconocido'

        })

    }

}


// ========================================
// EXPORTAR
// ========================================

